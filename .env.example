# Application
APP_NAME="Work Schedule Manager"
APP_VERSION=1.0.0-dev
APP_URL=http://localhost
APP_DEBUG=false

# Session
SESSION_NAME=work_schedule_manager_session

# Secure cookie mode is detected automatically from APP_URL / HTTPS.
# Uncomment only if you need an explicit override.
# SESSION_SECURE_COOKIE=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=work_schedule_manager
